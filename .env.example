# ---------------------------------------------------------------------------
# Hemvist – miljövariabler
#
# Kopiera till .env och fyll i. I produktionsläge vägrar servern starta om
# hemligheterna saknas eller är för korta, i stället för att gissa ett värde.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGINS=http://localhost:5173

# --- Databas ---------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=hemvist

# Ägaranslutning. Används endast av migreringar och seed.
PGADMINUSER=postgres
PGADMINPASSWORD=postgres

# Applikationens anslutning. Rollen skapas av migreringsverktyget och får
# varken vara superuser eller ha BYPASSRLS – det är förutsättningen för att
# kundsepareringen ska ha verkan.
APP_DB_USER=hemvist_app
APP_DB_PASSWORD=byt-detta-i-drift
# DATABASE_URL=postgresql://hemvist_app:...@db:5432/hemvist

# --- Hemligheter (minst 32 tecken i produktion) ----------------------------
# Signering av åtkomsttoken.
JWT_SECRET=
# Nyckel för hashning av uppslagsbara värden, t.ex. personnummer och
# anonyma enkätsvar. Byts aldrig utan migrering av befintliga värden.
LOOKUP_PEPPER=

# --- Sessioner -------------------------------------------------------------
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
STAFF_IDLE_TIMEOUT=1800
RESIDENT_IDLE_TIMEOUT=1209600
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15
REQUIRE_VERIFIED_EMAIL=true

# --- Fillagring ------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_ROOT=./var/storage
MAX_FILE_BYTES=26214400
MAX_FILES_PER_REQUEST=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,video/mp4,video/quicktime,application/pdf

# --- Bakgrundsjobb ---------------------------------------------------------
JOBS_ENABLED=true
JOBS_INTERVAL_MS=60000

# --- Övrigt ----------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
LOG_LEVEL=info
