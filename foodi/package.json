{
  "name": "foodi",
  "version": "0.1.0",
  "private": true,
  "description": "Foodi – beställ takeaway och hämta själv",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/inline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "~1.56.1",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
